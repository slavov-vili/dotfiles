# --------------------------------------
# Variables
# --------------------------------------

set $mod Mod4
set $alt Mod1

# Home row direction keys, like vim
set $left  h
set $down  j
set $up    k
set $right l

# Names for workspaces
set $ws1  "1: Terminal"
set $ws2  "2: Browser"
set $ws3  "3: IDE"
set $ws4  "4: Messages"
set $ws5  "5: Misc"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10: Vili"

set $mode_default "default"

set $mode_notify_warn   i3-nagbar -t warning -f 'pango:mono 12'
set $mode_unnotify_warn pkill -f 'i3-nagbar.*-t warning'

set $mode_notify_error   i3-nagbar -t error -f 'pango:mono 12'
set $mode_unnotify_error pkill -f 'i3-nagbar.*-t error'

set $launch_term    alacritty
set $launch_browser firefox
set $launch_fileexp nemo

set $launcher --no-startup-id sh ~/.config/rofi/scripts/app_launcher.sh

set $refresh_status_bar killall -SIGUSR1 polybar

# use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# --------------------------------------
# Options
# --------------------------------------

# Inner = between windows
# Outer = between windows and screen edge
gaps inner 5
gaps outer 5

for_window [all] title_window_icon on
for_window [all] title_window_icon padding 1px

default_border normal 2
default_floating_border normal 2
# hide_edge_borders smart

focus_follows_mouse no

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# focus same workspace to jump back to where you came from
# workspace_auto_back_and_forth yes

# Leave urgency hints a bit after focusing window. Might be helpful with multi-monitor
force_display_urgency_hint 500 ms

# --------------------------------------
# Window-specific settings
# --------------------------------------

# Open in specific workspace
for_window [class="^(?i).*term.*$"] move container to workspace $ws1, workspace $ws1
for_window [class="Alacritty"]      move container to workspace $ws1, workspace $ws1
for_window [window_role="browser"]  move container to workspace $ws2, workspace $ws2

# Always float
for_window [instance="git-gui"] floating enable
for_window [title="nagbar-cmd.*"] floating enable
# for_window [class="Git-gui"] floating enable


# --------------------------------------
# Theme
# --------------------------------------
include theme.conf

# --------------------------------------
# Key bindings
# --------------------------------------
include keybinds.conf

# --------------------------------------
# Executions
# --------------------------------------
include executions.conf

